# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server side Firebase Admin configuration. Prefer Application Default Credentials on Google hosting.
FIREBASE_PROJECT_ID="nexusmark-app"
FIRESTORE_DATABASE_ID="(default)"
# Optional only for environments without ADC. Store as a deployment secret, never commit it.
# FIREBASE_SERVICE_ACCOUNT_JSON="{...}"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SCREENSHOT PROVIDER CONFIGURATION (Optional overrides):
# Built-in: Headless Chromium multi-tier renderer (1440x900 desktop & 375x812 mobile viewports) with SSRF protection.
# SCREENSHOT_SERVICE_URL: Optional private headless browser rendering microservice endpoint (POST/GET).
# SCREENSHOTONE_API_KEY: Optional commercial ScreenshotOne API access key.
# GEMMA_MODEL: Model alias to use for AI brand intelligence (defaults to "gemma-4-26b-a4b-it").


# --- Phase 2: Content Studio / Content Calendar ---
# Optional. Recommended currently supported Gemini image model for branded graphics.
# Verify access for this API key in Google AI Studio before setting it.
# IMAGE_GENERATION_MODEL=gemini-3.1-flash-image
IMAGE_GENERATION_MODEL=""

# --- Firebase WEB config (public identifiers, optional) ---
# Defaults come from firebase-applet-config.json. If you set these at BUILD time they override it.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=nexusmark-app.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=nexusmark-app
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=nexusmark-app.firebasestorage.app
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
