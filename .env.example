# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server side Firebase Admin configuration. Prefer Application Default Credentials on Google hosting.
FIREBASE_PROJECT_ID="yodeling-bonbon-slxdt"
FIRESTORE_DATABASE_ID="ai-studio-b697daa1-5215-463a-8049-ab78ad384805"
# Optional only for environments without ADC. Store as a deployment secret, never commit it.
# FIREBASE_SERVICE_ACCOUNT_JSON="{...}"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SCREENSHOT PROVIDER CONFIGURATION (Optional overrides):
# Built-in: Headless Chromium multi-tier renderer (1440x900 desktop & 375x812 mobile viewports) with SSRF protection.
# SCREENSHOT_SERVICE_URL: Optional private headless browser rendering microservice endpoint (POST/GET).
# SCREENSHOTONE_API_KEY: Optional commercial ScreenshotOne API access key.
# GEMMA_MODEL: Model alias to use for AI brand intelligence (defaults to "gemma-4-26b-a4b-it").


# --- Phase 2: Content Studio / Content Calendar ---
# Optional. Recommended currently supported Gemini image model for branded graphics.
# Verify access for this API key in Google AI Studio before setting it.
# IMAGE_GENERATION_MODEL=gemini-3.1-flash-image
IMAGE_GENERATION_MODEL=""
