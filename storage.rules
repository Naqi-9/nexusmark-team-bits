rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    match /users/{userId}/workspaces/{workspaceId}/generated/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validImageUpload()
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.workspaceId == workspaceId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
